{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "members.json"
    }
  },
  "rewrites": [
    {
      "source": "/redirect",
      "destination": "/server.js"
    },
    {
      "source": "/random",
      "destination": "/server.js"
    },
    {
      "source": "/members.json",
      "destination": "/server.js"
    }
  ]
}
